{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "aspen",
  "name": "bluejutzu docs",
  "description": "Documentation for every bluejutzu project, in one place.",
  "colors": {
    "primary": "#58A6FF",
    "light": "#79C0FF",
    "dark": "#1F6FEB"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "appearance": {
    "default": "system"
  },
  "navigation": {
    "products": [
      {
        "product": "bmux",
        "icon": "image",
        "logo": {
          "light": "/bmux/logo/icon.svg",
          "dark": "/bmux/logo/icon.svg"
        },
        "groups": [
          {
            "group": "Getting started",
            "pages": ["bmux/index", "bmux/installation"]
          },
          {
            "group": "Commands",
            "pages": ["bmux/commands/convert", "bmux/commands/optimize", "bmux/commands/inspect"]
          }
        ]
      },
      {
        "product": "GLua",
        "icon": "code",
        "tabs": [
          {
            "tab": "Guides",
            "groups": [
              {
                "group": "Get Started",
                "pages": ["glua/index", "glua/installation", "glua/quickstart"]
              },
              {
                "group": "Features",
                "pages": [
                  "glua/features/intellisense",
                  "glua/features/typing-your-code",
                  "glua/features/realms",
                  "glua/features/net-messages",
                  "glua/features/hooks",
                  "glua/features/assets",
                  "glua/features/hot-paths",
                  "glua/features/report"
                ]
              },
              {
                "group": "Formatting",
                "pages": ["glua/features/formatter"]
              },
              {
                "group": "Configuration",
                "pages": [
                  "glua/configuration/overview",
                  "glua/configuration/config-files",
                  "glua/configuration/frameworks",
                  "glua/configuration/suppressions"
                ]
              },
              {
                "group": "Changelog",
                "pages": ["glua/changelog", "glua/cli-changelog"]
              }
            ]
          },
          {
            "tab": "Reference",
            "groups": [
              {
                "group": "Language",
                "pages": ["glua/reference/rules", "glua/reference/annotations"]
              },
              {
                "group": "Config Schemas",
                "pages": [
                  "glua/reference/glua-schema",
                  "glua/reference/gluafmtrc-schema",
                  "glua/reference/baseline-schema"
                ]
              },
              {
                "group": "Tools",
                "pages": [
                  "glua/reference/commands",
                  "glua/reference/cli",
                  "glua/reference/editors",
                  "glua/reference/performance"
                ]
              }
            ]
          },
          {
            "tab": "Contributing",
            "groups": [
              {
                "group": "Internals",
                "pages": ["glua/contributing/architecture", "glua/contributing/development"]
              },
              {
                "group": "Maintaining",
                "pages": ["glua/contributing/publishing"]
              }
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "icon": "github",
        "href": "https://github.com/Bluejutzu"
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/Bluejutzu"
    }
  },
  "search": {
    "prompt": "Search bluejutzu docs"
  },
  "contextual": {
    "options": ["copy", "view", "download-pdf"],
    "display": "header"
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": "system"
  },
  "fonts": {
    "heading": {
      "family": "Poppins",
      "weight": 600
    },
    "body": {
      "family": "Inter"
    }
  }
}
